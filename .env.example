# Copy to .env and fill in. Values below match docker-compose.yml for local development.

# Public URL of the app, used in emails and Paystack callbacks.
APP_URL=http://localhost:3001

# Postgres
DATABASE_URL=postgres://rentaride:rentaride@127.0.0.1:5436/rentaride
TEST_DATABASE_URL=postgres://rentaride:rentaride@127.0.0.1:5436/rentaride_test

# Redis (BullMQ, rate limits, caches)
REDIS_URL=redis://127.0.0.1:6383

# 32+ random bytes, base64. Used to HMAC email codes and reset tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Email. Development uses Mailpit (inbox: http://localhost:8026). Production: SES SMTP.
SMTP_HOST=127.0.0.1
SMTP_PORT=1026
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="RentARide <no-reply@rentaride.ng>"
SUPPORT_EMAIL=support@rentaride.ng

# S3-compatible storage. Development uses SeaweedFS; leave S3_ENDPOINT empty for AWS S3.
S3_ENDPOINT=http://127.0.0.1:9010
S3_REGION=us-east-1
S3_BUCKET=rentaride-uploads
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev

# Paystack (https://dashboard.paystack.com/#/settings/developers). Use test keys locally.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
