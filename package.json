{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env --conditions=react-server scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env --conditions=react-server scripts/seed.ts --reset",
    "db:studio": "drizzle-kit studio",
    "worker": "tsx --env-file-if-exists=.env --conditions=react-server src/worker/index.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env --conditions=react-server src/worker/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "job": "tsx --env-file-if-exists=.env --conditions=react-server scripts/run-job.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@base-ui/react": "^1.9.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@node-rs/argon2": "^2.2.2",
    "bullmq": "^6.7.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "gsap": "3.12.5",
    "handlebars": "^4.7.10",
    "input-otp": "^1.5.0",
    "ioredis": "^6.1.0",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
