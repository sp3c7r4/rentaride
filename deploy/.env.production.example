# Copy to deploy/.env.production on the server. Never commit the real file.
NODE_ENV=production
APP_URL=https://rentaride.ng

# RDS Postgres 18. Require TLS.
DATABASE_URL=postgres://rentaride:CHANGE_ME@your-db.xxxxxx.eu-west-1.rds.amazonaws.com:5432/rentaride?sslmode=require

# ElastiCache (rediss:// for TLS) or the bundled container: redis://redis:6379
REDIS_URL=rediss://your-cache.xxxxxx.cache.amazonaws.com:6379

# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=CHANGE_ME

# SES SMTP credentials (SES console > SMTP settings). The From domain must be verified in SES.
SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
EMAIL_FROM="RentARide <no-reply@rentaride.ng>"
SUPPORT_EMAIL=support@rentaride.ng

# S3. Leave S3_ENDPOINT and the keys empty to use the EC2 instance role.
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=rentaride-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Paystack live keys (Settings > API Keys & Webhooks).
PAYSTACK_SECRET_KEY=sk_live_CHANGE_ME
PAYSTACK_PUBLIC_KEY=pk_live_CHANGE_ME
